import { db } from '@/lib/db';
import { get2FASecret, set2FASecret, markBackupCodeUsed, isBackupCodeUsed } from '@/lib/redis';
import crypto from 'crypto';

/**
 * Generate TOTP secret and backup codes for a user
 */
export async function generate2FASecret(userId: string): Promise<{
  secret: string;
  otpauthUrl: string;
  backupCodes: string[];
}> {
  // Generate 32-byte secret (256 bits)
  const secretBuffer = crypto.randomBytes(32);
  const secret = base32Encode(secretBuffer);
  
  // Generate 10 backup codes
  const backupCodes = Array.from({ length: 10 }, () => 
    crypto.randomBytes(4).toString('hex').toUpperCase()
  );
  
  // Create OTPAuth URL for QR code
  const otpauthUrl = `otpauth://totp/ClickAnunt:${encodeURIComponent(
    `admin-${userId}`
  )}?secret=${secret}&issuer=ClickAnunt&algorithm=SHA1&digits=6&period=30`;
  
  // Store in Redis temporarily (expires in 24 hours)
  await set2FASecret(userId, {
    secret,
    backupCodes,
    verified: false,
    createdAt: Date.now(),
  }, 86400);
  
  return { secret, otpauthUrl, backupCodes };
}

/**
 * Verify and enable 2FA for user
 */
export async function enable2FA(
  userId: string,
  verificationCode: string
): Promise<boolean> {
  try {
    // Get temporary secret from Redis
    const secretData = await get2FASecret(userId);
    if (!secretData || !secretData.secret) {
      throw new Error('2FA secret not found. Please generate a new one.');
    }
    
    // Verify the code
    if (!verifyTOTP(secretData.secret, verificationCode)) {
      throw new Error('Invalid verification code');
    }
    
    // Store backup codes in database (encrypted)
    for (const code of secretData.backupCodes) {
      await db.TwoFactorBackupCode.create({
        data: {
          userId,
          code: crypto
            .createCipher('aes-256-cbc', process.env.ENCRYPTION_KEY || 'default-key')
            .update(code, 'utf8', 'hex') +
            crypto.createCipher('aes-256-cbc', process.env.ENCRYPTION_KEY || 'default-key').final('hex'),
          used: false,
        },
      });
    }
    
    // Update user with encrypted 2FA secret
    const encryptedSecret = crypto
      .createCipher('aes-256-cbc', process.env.ENCRYPTION_KEY || 'default-key')
      .update(secretData.secret, 'utf8', 'hex') +
      crypto.createCipher('aes-256-cbc', process.env.ENCRYPTION_KEY || 'default-key').final('hex');
    
    await db.user.update({
      where: { id: userId },
      data: {
        twoFactorSecret: encryptedSecret,
        twoFactorEnabled: true,
      },
    });
    
    // Log the event
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'enabled',
        success: true,
      },
    });
    
    // Clear Redis cache
    await set2FASecret(userId, { secret: '', backupCodes: [], verified: true, createdAt: 0 }, 1);
    
    return true;
  } catch (error) {
    console.error('[2FA] Enable error:', error);
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'enabled',
        success: false,
        details: { error: String(error) },
      },
    });
    return false;
  }
}

/**
 * Disable 2FA for user
 */
export async function disable2FA(userId: string): Promise<boolean> {
  try {
    await db.user.update({
      where: { id: userId },
      data: {
        twoFactorSecret: null,
        twoFactorEnabled: false,
      },
    });
    
    // Delete all backup codes
    await db.TwoFactorBackupCode.deleteMany({
      where: { userId },
    });
    
    // Log the event
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'disabled',
        success: true,
      },
    });
    
    return true;
  } catch (error) {
    console.error('[2FA] Disable error:', error);
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'disabled',
        success: false,
        details: { error: String(error) },
      },
    });
    return false;
  }
}

/**
 * Verify TOTP code during login
 */
export async function verifyTOTPLogin(
  userId: string,
  code: string,
  ipAddress?: string,
  userAgent?: string
): Promise<boolean> {
  try {
    const user = await db.user.findUnique({
      where: { id: userId },
      select: { twoFactorSecret: true, twoFactorEnabled: true },
    });
    
    if (!user || !user.twoFactorEnabled || !user.twoFactorSecret) {
      throw new Error('2FA not configured');
    }
    
    // Decrypt secret
    const decrypted = decryptField(user.twoFactorSecret);
    
    // Verify code
    const isValid = verifyTOTP(decrypted, code);
    
    // Log attempt
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'verified',
        success: isValid,
        ipAddress,
        userAgent,
      },
    });
    
    return isValid;
  } catch (error) {
    console.error('[2FA] Verification error:', error);
    return false;
  }
}

/**
 * Use backup code (one-time use)
 */
export async function useBackupCode(
  userId: string,
  code: string,
  ipAddress?: string,
  userAgent?: string
): Promise<boolean> {
  try {
    // Check if already used in Redis
    const alreadyUsed = await isBackupCodeUsed(userId, code);
    if (alreadyUsed) {
      throw new Error('Backup code already used');
    }
    
    // Find backup code in database
    const backupCode = await db.TwoFactorBackupCode.findFirst({
      where: { userId, code: encryptField(code) },
    });
    
    if (!backupCode || backupCode.used) {
      throw new Error('Invalid backup code');
    }
    
    // Mark as used
    await db.TwoFactorBackupCode.update({
      where: { id: backupCode.id },
      data: {
        used: true,
        usedAt: new Date(),
      },
    });
    
    // Mark in Redis for quick lookup
    await markBackupCodeUsed(userId, code);
    
    // Log the event
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'backup_used',
        success: true,
        ipAddress,
        userAgent,
      },
    });
    
    return true;
  } catch (error) {
    console.error('[2FA] Backup code error:', error);
    await db.twoFactorLog.create({
      data: {
        userId,
        action: 'backup_used',
        success: false,
        ipAddress,
        userAgent,
        details: { error: String(error) },
      },
    });
    return false;
  }
}

/**
 * RFC 6238 TOTP Verification
 */
export function verifyTOTP(secret: string, token: string, window = 1): boolean {
  const now = Math.floor(Date.now() / 1000);
  const timeStep = 30;
  
  for (let i = -window; i <= window; i++) {
    let timeCounter = Math.floor((now + i * timeStep) / timeStep);
    const hmac = crypto.createHmac('sha1', base32Decode(secret));
    
    const buf = Buffer.alloc(8);
    for (let j = 7; j >= 0; j--) {
      buf[j] = timeCounter & 0xff;
      timeCounter = timeCounter >> 8;
    }
    
    hmac.update(buf);
    const digest = hmac.digest();
    const offset = digest[digest.length - 1] & 0xf;
    const otp = (
      ((digest[offset] & 0x7f) << 24) |
      ((digest[offset + 1] & 0xff) << 16) |
      ((digest[offset + 2] & 0xff) << 8) |
      (digest[offset + 3] & 0xff)
    ) % 1000000;
    
    const paddedOtp = otp.toString().padStart(6, '0');
    if (paddedOtp === token) {
      return true;
    }
  }
  
  return false;
}

/**
 * Base32 encoding (for TOTP secrets)
 */
function base32Encode(buffer: Buffer): string {
  const base32chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
  let bits = 0;
  let value = 0;
  let output = '';
  
  for (let i = 0; i < buffer.length; i++) {
    value = (value << 8) | buffer[i];
    bits += 8;
    while (bits >= 5) {
      output += base32chars[(value >>> (bits - 5)) & 31];
      bits -= 5;
    }
  }
  
  if (bits > 0) {
    output += base32chars[(value << (5 - bits)) & 31];
  }
  
  // Padding
  while (output.length % 8) {
    output += '=';
  }
  
  return output;
}

/**
 * Base32 decoding (for TOTP verification)
 */
function base32Decode(str: string): Buffer {
  const base32chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
  let bits = 0;
  let value = 0;
  const output: number[] = [];
  
  for (let i = 0; i < str.length; i++) {
    const idx = base32chars.indexOf(str[i].toUpperCase());
    if (idx === -1) throw new Error('Invalid character in base32 string');
    value = (value << 5) | idx;
    bits += 5;
    if (bits >= 8) {
      output.push((value >>> (bits - 8)) & 0xff);
      bits -= 8;
    }
  }
  
  return Buffer.from(output);
}

/**
 * Encrypt field (simple AES encryption)
 */
function encryptField(value: string): string {
  const cipher = crypto.createCipher('aes-256-cbc', process.env.ENCRYPTION_KEY || 'default-key');
  return cipher.update(value, 'utf8', 'hex') + cipher.final('hex');
}

/**
 * Decrypt field
 */
function decryptField(encrypted: string): string {
  const decipher = crypto.createDecipher('aes-256-cbc', process.env.ENCRYPTION_KEY || 'default-key');
  return decipher.update(encrypted, 'hex', 'utf8') + decipher.final('utf8');
}

/**
 * Get user 2FA status
 */
export async function get2FAStatus(userId: string): Promise<{
  enabled: boolean;
  backupCodesRemaining: number;
}> {
  try {
    const user = await db.user.findUnique({
      where: { id: userId },
      select: { twoFactorEnabled: true },
    });
    
    if (!user) {
      throw new Error('User not found');
    }
    
    const backupCodes = await db.TwoFactorBackupCode.count({
      where: {
        userId,
        used: false,
      },
    });
    
    return {
      enabled: user.twoFactorEnabled,
      backupCodesRemaining: backupCodes,
    };
  } catch (error) {
    console.error('[2FA] Status error:', error);
    return {
      enabled: false,
      backupCodesRemaining: 0,
    };
  }
}
