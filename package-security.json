{
  "name": "auto-platform-security",
  "version": "1.0.0",
  "description": "Security baseline implementation for ClickAnunț",
  "scripts": {
    "security:test": "bash scripts/security-test.sh",
    "security:audit": "npm audit && npm outdated",
    "security:headers": "curl -I http://localhost:3000/ | grep -E '(Content-Security|Strict-Transport|X-Frame|X-Content-Type|Referrer)'",
    "security:zap": "docker run -t owasp/zap2docker-stable zap-baseline.py -t http://localhost:3000 -r zap-report.html"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "isomorphic-dompurify": "^2.9.0",
    "sharp": "^0.33.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5"
  }
}
