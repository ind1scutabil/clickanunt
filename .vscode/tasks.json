{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy to Production (Auto)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deploy-auto"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_ENV": "production"
        }
      },
      "runOptions": {
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Deploy to Production (Manual)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deploy"],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    {
      "label": "Pre-deploy Checks",
      "type": "shell",
      "command": "npm",
      "args": ["run", "preflight"],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$eslint-stylish",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Build for Production",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": "$tsc",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "NODE_ENV": "production"
        }
      }
    }
  ]
}