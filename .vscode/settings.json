{
  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/*.log": true,
    "**/.cache": true,
    "**/.env": true,
    "**/.env.local": true,
    "**/.DS_Store": true,
    "**/tsconfig.tsbuildinfo": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.cache": true,
    "**/.prisma": true,
    "**/prisma/migrations": true
  },
  "files.watcherExclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/.git": true,
    "**/.turbo": true,
    "**/coverage": true,
    "**/.cache": true,
    "**/dist": true,
    "**/build": true,
    "**/.prisma": true,
    "**/prisma/client": true,
    "**/.vscode-server": true,
    "**/*.lock": true,
    "**/.vercel": true,
    "**/logs": true,
    "**/tmp": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "eslint.enable": true,
  "eslint.run": "onSave",
  "eslint.lintTask.enable": true,
  "eslint.debug": false,
  "prettier.enable": true,
  "prettier.requireConfig": false,
  "[json]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "[typescript]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.maxTsServerMemory": 6144,
  "typescript.tsserver.log": "off",
  "typescript.tsserver.logVerbosity": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.suggest.enabled": true,
  "typescript.suggest.autoImports": true,
  "typescript.suggest.completeJSDocs": false,
  "typescript.suggest.jsdoc.enabled": false,
  "typescript.validate.enable": true,
  "typescript.check.npmIsInstalled": false,
  "typescript.tsserver.skipLibCheck": true,
  "typescript.tsserver.useSeparateSyntaxServer": false,
  "typescript.tsserver.pollForChanges": false,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling",
    "synchronousWatchDirectory": false,
    "excludeDirectories": ["**/node_modules", "**/.next", "**/.git", "**/dist", "**/.turbo", "**/coverage"]
  },
  "typescript.defaultSourceFileCommand": "open",
  "typescript.quickSuggestionsDelay": 100,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,
  "editor.formatOnPaste": false,
  "editor.inlayHints.enabled": "off",
  "editor.inlayHints.parameter.enabled": false,
  "editor.inlayHints.type.enabled": false,
  "editor.quickSuggestions": {
    "strings": false,
    "comments": false,
    "other": true
  },
  "editor.quickSuggestionsDelay": 100,
  "editor.parameterHints.enabled": true,
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.codeActionsOnSave": {},
  "editor.defaultFormatter": null,
  "editor.formatOnSave": false,
  "files.autoSave": "off",
  "files.autoSaveDelay": 1000,
  "files.hotExit": "off",
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "git.autofetch": false,
  "git.autorefresh": false,
  "git.ignoreLimitWarning": true,
  "git.scanRepositories": false,
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "markdown.preview.breaks": false,
  "markdown.preview.fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
  "markdown.preview.linkify": false,
  "markdown.preview.scrollPreviewWithEditor": false,
  "extensions.recommendations": [
    "prisma.prisma"
  ],
  "extensions.ignoreRecommendations": false,
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.list.smoothScrolling": false,
  "workbench.tree.renderIndentGuides": "none",
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": false,
  "editor.occurrencesHighlight": "off",
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.renderLineHighlight": "none",
  "editor.showUnused": false,
  "editor.guides.bracketPairs": false,
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,
  "editor.minimap.enabled": false,
  "editor.minimap.renderCharacters": false,
  "breadcrumbs.enabled": false,
  "explorer.autoReveal": false,
  "explorer.autoExpandSingleChild": false,
  "outline.icons": false,
  "outline.follow": false,
  "problems.autoReveal": false,
  "problems.showCurrentInStatus": false,
  "debug.showBreakpointsInOverviewRuler": false,
  "debug.showInlineBreakpointCandidates": false,
  "css.lint.unknownAtRules": "ignore",
  "css.lint.validProperties": [
    "composes"
  ],
  "tailwindCSS.validate": true,
  "tailwindCSS.hover": true,
  "tailwindCSS.showPixelEquivalents": false,
  "tailwindCSS.suggestions": true,
  "tailwindCSS.emmetCompletions": true,
  "[css]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false
  },
  "prisma.pinnedLanguage": "",
  "prisma.logLevel": "info",
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.mode": "none",
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "prisma.pinToPrisma6": true
}
