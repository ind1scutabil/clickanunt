    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^8.55.2",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@types/dompurify": "^3.0.5",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.12.9",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.2",
    "isomorphic-dompurify": "^3.0.0-rc.2",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.6",
    "next-image-export-optimizer": "^1.14.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.17.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^2.15.4",
    "redis": "^5.10.0",
    "sharp": "^0.33.5",
    "speakeasy": "^2.0.0",
    "stripe": "^20.3.0",
    "uuid": "^13.0.0",
    "validator": "^13.15.26",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/validator": "^13.15.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  }
}
