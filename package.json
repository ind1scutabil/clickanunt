{
  "name": "clickanunt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node ./node_modules/jest/bin/jest.js --passWithNoTests",
    "test:integration": "node ./node_modules/jest/bin/jest.js -c jest.integration.config.js --passWithNoTests",
    "test:watch": "node ./node_modules/jest/bin/jest.js --watch",
    "test:e2e": "E2E_DISABLE_RATE_LIMIT=1 playwright test",
    "test:e2e:headless": "E2E_DISABLE_RATE_LIMIT=1 playwright test",
    "test:e2e:messaging": "E2E_DISABLE_RATE_LIMIT=1 playwright test tests/e2e/messaging-two-users.spec.ts --project=chromium",
    "preflight": "npm run lint && npm run type-check && npm run test && npm run build",
    "verify": "npm run lint && npm run type-check && npm run test",
    "deploy": "./scripts/deploy-local.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:vps": "./scripts/deploy-vps.sh",
    "deploy-safe": "./scripts/deploy-safe.sh",
    "deploy-prod": "./scripts/deploy-prod.sh",
    "deploy:prod": "./scripts/deploy-prod-from-local.sh",
    "deploy-auto": "./scripts/deploy-auto.sh",
    "rollback": "./scripts/rollback.sh",
    "preflight-prod": "./scripts/preflight-prod.sh",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:backup": "./scripts/backup-db.sh",
    "db:restore": "./scripts/restore-db.sh",
    "expire-promotions": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/expire-promotions.ts",
    "verify:listing-asset": "node scripts/verify-default-listing-asset.mjs",
    "sanitize:listing-photos:dry": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/sanitize-listing-photos.ts --dry-run",
    "sanitize:listing-photos:execute": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/sanitize-listing-photos.ts --execute",
    "unlock-login": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/reset-login.ts",
    "debug:messaging": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/messaging-debug-two-users.ts",
    "test:messaging-flow": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/test-messaging-flow.ts",
    "load:messaging-redis": "npx ts-node --transpile-only --project tsconfig.scripts.json scripts/messaging-load-smoke.ts",
    "load:homepage": "node scripts/load/homepage.mjs",
    "load:listings-page": "node scripts/load/listings-page.mjs",
    "load:listing": "node scripts/load/listing.mjs",
    "load:listing-images": "node scripts/load/listing-images.mjs",
    "load:search": "node scripts/load/search.mjs",
    "load:dashboard": "node scripts/load/dashboard.mjs",
    "load:messaging": "node scripts/load/messaging.mjs",
    "load:sse": "node scripts/load/sse.mjs",
    "load:payments-readonly": "node scripts/load/payments-readonly.mjs",
    "load:stripe-webhook-safe": "node scripts/load/stripe-webhook-safe.mjs",
    "load:auth-session": "node scripts/load/auth-session.mjs",
    "load:health": "node scripts/load/health.mjs",
    "load:login-safe": "node scripts/load/login-safe.mjs",
    "load:run-all": "node scripts/load/run-all-profiles.mjs",
    "load:static-analysis": "node scripts/load/static-analysis.mjs",
    "load:messages-staging": "node scripts/load/messaging.mjs",
    "load:listings-staging": "node scripts/load/create-listing-staging.mjs",
    "validate:staging": "node scripts/staging/validate-readiness.mjs",
    "verify:critical-paths": "node scripts/stability/verify-critical-paths.mjs",
    "safety:audit": "node scripts/production/safety-audit.mjs",
    "safety:audit:ssh": "node scripts/production/safety-audit.mjs --ssh",
    "pm2:validate": "node scripts/production/validate-ecosystem.mjs",
    "audit:stripe": "node scripts/production/audit-stripe-safety.mjs",
    "audit:db-patterns": "node scripts/production/audit-db-patterns.mjs",
    "load:stability-evidence": "node scripts/load/run-stability-evidence.mjs",
    "prod:smoke": "node scripts/production/prod-smoke.mjs",
    "images:backfill": "npx ts-node -r tsconfig-paths/register --transpile-only --project tsconfig.scripts.json scripts/images-backfill-variants.ts",
    "predeploy:audit": "node scripts/production/pre-deploy-audit.mjs",
    "staging:verify-redis": "node scripts/staging/verify-redis-integration.mjs",
    "staging:verify-sse-cluster": "node scripts/staging/verify-sse-cluster.mjs",
    "load:staged": "node scripts/load/run-staged-concurrency.mjs",
    "load:phase4b": "node scripts/load/phase4b-suite.mjs",
    "staging:isolation": "node scripts/staging/verify-production-isolation.mjs",
    "staging:metrics": "node scripts/staging/collect-runtime-metrics.mjs",
    "deploy:staging": "bash scripts/deploy-staging-from-local.sh",
    "staging:load-campaign": "bash scripts/staging/run-load-campaign.sh"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
