    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "express-rate-limit": "^8.2.1",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.6",
    "next-image-export-optimizer": "^1.14.1",
    "openai": "^6.17.0",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.33.2",
    "speakeasy": "^2.0.0",
    "stripe": "^20.3.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/validator": "^13.15.10",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "prisma": "^7.3.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  }
