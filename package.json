    "next": "16.1.6",
    "next-image-export-optimizer": "^1.14.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.17.0",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "^5.10.0",
    "sharp": "^0.33.5",
