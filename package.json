    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "express-rate-limit": "^8.2.1",
