{
  "name": "clickanunt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preview": "node dev_preview/server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run build && npx prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:backup": "./scripts/backup-db.sh",
    "db:restore": "./scripts/restore-db.sh",
    "init-owner": "tsx scripts/init-owner.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "check-tables": "tsx scripts/check-tables.ts",
    "trust-score:update": "node -e \"require('./lib/trustScore').batchUpdateTrustScores(1000)\""
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@prisma/adapter-pg": "^7.3.0",
