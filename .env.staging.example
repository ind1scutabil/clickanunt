# =============================================================================
# ClickAnunț STAGING — example only. Copy to server .env (never commit secrets).
# Replace every REQUIRED_* value after provisioning. Scripts refuse placeholders.
# =============================================================================

# --- Host / site (must NOT be production) ---
# Production IP (forbidden as default staging target): 46.225.69.155
# Production domains (forbidden): clickanunt.ro, www.clickanunt.ro
STAGING_DEPLOY_SERVER="REQUIRED_STAGING_DEPLOY_SERVER"
STAGING_DEPLOY_DIR="/var/www/clickanunt-staging"
STAGING_APP_CWD="/var/www/clickanunt-staging"
STAGING_DOMAIN="REQUIRED_STAGING_DOMAIN"
NEXT_PUBLIC_SITE_URL="https://REQUIRED_STAGING_DOMAIN"
NEXT_PUBLIC_API_URL="https://REQUIRED_STAGING_DOMAIN"
STAGING_SITE=1
NEXT_PUBLIC_STAGING_SITE=1

# Confirm explicit staging deploy (preflight)
# CONFIRM_STAGING_DEPLOY=1
# STAGING_BACKUP_VERIFIED=1

# --- Database (dedicated staging DB — never production autoplat on prod host) ---
DATABASE_URL="REQUIRED_STAGING_DATABASE_URL"

# --- Runtime ---
NODE_ENV=production
PORT=3001
JWT_SECRET="REQUIRED_STAGING_JWT_SECRET_min_32_chars"
SESSION_SECRET="REQUIRED_STAGING_SESSION_SECRET"

# --- Forbidden on staging runtime ---
# E2E_DISABLE_RATE_LIMIT=1
# CLICKANUNT_E2E_SERVER=1

# --- Stripe TEST only (sk_live / pk_live forbidden) ---
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
STRIPE_ALLOW_TEST_KEYS_IN_PRODUCTION=1
# Requires STAGING_SITE=1 (already set above). Alone is insufficient; production
# fingerprints in DATABASE_URL / SITE_URL are refused by stripe-production-guard.

# --- Redis (dedicated staging instance or DB index — not production) ---
# REDIS_URL="REQUIRED_STAGING_REDIS_URL"
# USE_REDIS_RATE_LIMIT=1

# --- Object storage (dedicated staging bucket — not production CDN) ---
# S3_ENDPOINT="REQUIRED_STAGING_S3_ENDPOINT"
# S3_REGION="REQUIRED_STAGING_S3_REGION"
# S3_BUCKET="REQUIRED_STAGING_S3_BUCKET"
# S3_ACCESS_KEY_ID="REQUIRED_STAGING_S3_ACCESS_KEY_ID"
# S3_SECRET_ACCESS_KEY="REQUIRED_STAGING_S3_SECRET_ACCESS_KEY"
# CDN_URL="REQUIRED_STAGING_CDN_URL"

# --- Email: sandbox or fully disabled (no real user mail) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# Or use a provider sandbox; do not point at production SMTP credentials.

# --- Analytics: keep disabled on staging ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_CLARITY_ID=

# --- Ops ---
# CRON_SECRET="REQUIRED_STAGING_CRON_SECRET"
# ENABLE_STAGING_LOAD_DIAGNOSTICS=1
