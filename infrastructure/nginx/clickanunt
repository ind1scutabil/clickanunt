# Rate limit zones
limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=register:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=addr:10m;

# Rate limit for DDoS protection
limit_req_status 429;
limit_conn_status 429;

# HTTP server - redirect to HTTPS on www
server {
    listen 80;
    listen [::]:80;
    server_name clickanunt.ro www.clickanunt.ro clikanunt.ro www.clikanunt.ro;
    
    # Let's Encrypt validation
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    
    # Redirect all HTTP to HTTPS
    location / {
        return 301 https://www.clickanunt.ro$request_uri;
    }
}

# HTTPS server - clickanunt.ro redirect to www.clickanunt.ro
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name clickanunt.ro;

    ssl_certificate /etc/letsencrypt/live/clickanunt.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clickanunt.ro/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/clickanunt.ro/chain.pem;

    # Redirect to www version
    return 301 https://www.clickanunt.ro$request_uri;
}

# HTTPS server - main site
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.clickanunt.ro;

    ssl_certificate /etc/letsencrypt/live/clickanunt.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/clickanunt.ro/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/clickanunt.ro/chain.pem;

    # Block common attack patterns
    location ~ /(wp-admin|wp-login|phpmyadmin|xmlrpc) {
        deny all;
        return 404;
    }

    # Block sensitive files
    location ~* \.(sql|bak|old|log|env|git|svn)$ {
        deny all;
        return 404;
    }

    # Security headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    server_tokens off;

    limit_req zone=general burst=20 nodelay;

    # SSE mesaje: fără buffering (altfel clientul nu primește evenimente până la timeout)
    location = /api/messages/events {
        limit_req zone=api burst=30 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        gzip off;
        add_header Cache-Control "no-cache, no-transform" always;
        add_header X-Accel-Buffering "no" always;
    }

    location /api/ {
        limit_req zone=api burst=10 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /api/auth/login {
        #limit_req zone=login burst=50 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /api/auth/register {
        limit_req zone=register burst=1 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /_next/static/ {
        proxy_pass http://localhost:3000;
        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        limit_req zone=general burst=20 nodelay;
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
