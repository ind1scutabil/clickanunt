# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies & generated output (release hygiene)
node_modules/
.next/
dist/
build/
test-results/
playwright-report/
tests/e2e/.auth/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/fixtures/listing-photos/

# next.js
/out/

# Expo local state (machine-specific)
.expo/
apps/mobile/.expo/

# load test artifacts (Phase 3C)
scripts/load/results/

# image variant backfill resume state
.images-backfill-state.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example

# cleanup-seed-users.ts JSON backups (may contain PII)
/scripts/exports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# accidental backups / local debug artifacts
*.bak
*.backup

# archives & logs (do not commit large bundles)
*.tar.gz
*.zip
*.log

# --- User uploads & local storage (never commit; deploy uses mkdir on server only) ---
/public/uploads/
/uploads/
/storage/
/tmp/
.tmp/

# --- Local / tool caches ---
.eslintcache
.parcel-cache/
.turbo/

# --- Screenshots (any folder; never commit user captures) ---
**/Screenshot*.png
**/Screen Shot*.png

# --- IDE / agent local (never ship) ---
.cursor/

# --- Root-level session / audit churn (tracked files stay tracked; this hides new junk from git status) ---
/*_REPORT.md
/*.diff
/*_git_status.txt
/*SNAPSHOT.md
/ENTERPRISE_*.md
/FINAL_*.md
/PRE_*ENTERPRISE*
/SAFE_*_REPORT.md
/BUSINESS_*_REPORT.md
/ADMIN_*_REPORT.md
/LIVE_*_REPORT.md
/MANUAL_*_REPORT.md

# Allow these deliverables to be committed (overrides /*_REPORT.md and /FINAL_*.md above)
!/FINAL_RELEASE_READY_REPORT.md
!/FINAL_CONTROLLED_RELEASE_STATUS.md
!/POST_DEPLOY_VERIFICATION_REPORT.md

# Pre-deploy local snapshots (git SHA + timestamp; never ship DB dumps here)
/deploy-snapshots/

# Hero asset backups (local only; not part of runtime bundle)
/public/images/hero/*backup*
/public/images/hero/*-backup-*
.env.mobile-parity

# Generated development APKs from mobile parity audits (large binaries; keep local only)
docs/audits/faza21/*.apk
docs/audits/faza21/**/*.apk
apps/mobile/**/*.apk

