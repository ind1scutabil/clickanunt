# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies & generated output (release hygiene)
node_modules/
.next/
dist/
build/
test-results/
playwright-report/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# cleanup-seed-users.ts JSON backups (may contain PII)
/scripts/exports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# accidental backups / local debug artifacts
*.bak
*.backup

# archives & logs (do not commit large bundles)
*.tar.gz
*.zip
*.log
