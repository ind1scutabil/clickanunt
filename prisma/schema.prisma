generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  user
  dealer
  admin
  moderator
  owner
  support
  finance
}

enum ListingStatus {
  draft
  pending
  active
  paused
  expired
  sold
  deleted
  rejected
  hidden
}

enum ModerationStatus {
  pending
  approved
  rejected
  flagged
}

enum ReportStatus {
  pending
  investigating
  resolved
  dismissed
}

enum AppealStatus {
  pending
  under_review
  approved
  rejected
}

enum FuelType {
  petrol
  diesel
  electric
  hybrid
  other
}

enum Transmission {
  manual
  automatic
  semiautomatic
  other
}

enum Condition {
  new
  used
  refurbished
  for_parts
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
  cancelled
}

enum PaymentMethod {
  card
  apple_pay
  google_pay
  bank_transfer
}

enum InvoiceStatus {
  draft
  issued
  paid
  cancelled
}

enum PromotionType {
  boost_24h
  boost_72h
  boost_7days
  highlight
  featured
}

enum SubscriptionTier {
  free
  business
  premium
}

enum AccountType {
  private
  business
}

enum VerificationLevel {
  none
  email
  phone
  business
}

// ==================== MODELS ====================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(user)
  
  // Account Type & Profile
  accountType         AccountType @default(private)
  verificationLevel   VerificationLevel @default(none)
  
  // Personal profile
  name                String?
  phone               String?
  phoneVerified       Boolean @default(false)
  emailVerified       Boolean @default(false)
  avatar              String?
  
  // Business profile (doar pentru accountType = business)
  businessName        String?
  businessLogo        String?
  businessDescription String?  @db.Text
  businessLocation    String?
  businessPhone       String?
  businessWebsite     String?
  businessEmail       String?
  businessCUI         String?
  businessRegCom      String?
  
  // Trust & Security
  trustScore          Int      @default(50)
  isBanned            Boolean  @default(false)
  bannedAt            DateTime?
  bannedBy            String?
  banReason           String?
  
  // Seller Reputation & Activity
  lastActiveAt        DateTime @default(now())
  responseRate        Int      @default(0) // 0-100 percentage
  totalSales          Int      @default(0)
  totalListings       Int      @default(0)
  averageRating       Float    @default(0.0) // 0-5 stars (for future reviews)
  
  // Subscription & Monetization
  subscriptionTier    SubscriptionTier @default(free)
  subscriptionExpiresAt DateTime?
  subscriptionRenewsAt  DateTime?
  freeBoostsRemaining Int      @default(0)
  creditsBalance       Int      @default(0)
  promotionDiscountPercent Int  @default(0)
  promotionBenefits    Json?
  
  // 2FA
  twoFactorSecret     String?
  twoFactorEnabled    Boolean  @default(false)
  
  // Login tracking & lockout
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  
  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  listings            Listing[]
  reports             Report[]
  appeals             Appeal[]
  auditLogs           AuditLog[]
  moderationActions   ModerationQueue[] @relation("ModeratorActions")
  staffNotes          StaffNote[]
  payments            Payment[]
  invoices            Invoice[]
  verificationRequests VerificationRequest[]
  notifications       UserNotification[]
  createdBroadcasts   AdminBroadcast[] @relation("BroadcastCreator")
  
  @@index([email])
  @@index([role])
  @@index([isBanned])
  @@index([trustScore])
  @@index([createdAt])
  @@index([accountType])
  @@index([verificationLevel])
  @@index([businessName])
  @@map("users")
}

// 2FA Backup Codes - one-time use recovery codes
model TwoFactorBackupCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  
  @@unique([userId, code])
  @@index([userId])
  @@index([used])
  @@map("two_factor_backup_codes")
}

// 2FA Verification History - audit trail
model TwoFactorLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // "enabled", "disabled", "verified", "backup_used", "failed_attempt"
  success   Boolean  @default(true)
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("two_factor_logs")
}

model Listing {
  id            String        @id @default(uuid())
  ownerUserId   String
  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  title         String
  category      String
  subcategory   String?
  
  // Generic fields for all listings
  description   String?       @db.Text
  priceAmount   Int
  priceCurrency String        @default("RON")
  condition     Condition?    @default(used)
  photos        String[]      @default([])
  
  // Location
  county        String?
  city          String?
  region        String?
  
  // Auto-specific fields (nullable for non-auto listings)
  make          String?
  model         String?
  year          Int?
  mileage       Int?
  fuel          FuelType?
  transmission  Transmission?
  vin           String?
  
  // Dealer-specific fields (doar pentru business accounts în categoria AUTO)
  isDealer      Boolean       @default(false)
  dealerBrands  String[]      @default([])
  dealerPriceMin Int?
  dealerPriceMax Int?
  
  // Generic attributes stored as JSON
  attributes    Json?
  
  status        ListingStatus @default(pending)
  views         Int           @default(0)
  isFeatured    Boolean       @default(false)
  
  // Promotion fields
  isPromoted        Boolean       @default(false)
  promotionType     PromotionType?
  promotionExpiresAt DateTime?
  promotionStartedAt DateTime?
  
  // Scam detection
  scamScore         Int           @default(0)
  scamFlags         String[]      @default([])
  isScamSuspected   Boolean       @default(false)
  isDuplicate       Boolean       @default(false)
  duplicateOfId     String?
  
  // Moderation
  moderationStatus  ModerationStatus @default(pending)
  moderatedAt       DateTime?
  moderatedBy       String?
  moderationNotes   String?
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  publishedAt       DateTime?
  expiresAt         DateTime?

  // Relations
  reports           Report[]
  moderationQueue   ModerationQueue[]
  
  @@index([ownerUserId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([isPromoted])
  @@index([scamScore])
  @@index([moderationStatus])
  // Search performance indexes
  @@index([city])
  @@index([year])
  @@index([priceAmount])
  @@index([category, city])
  @@index([status, priceAmount])
  @@index([status, createdAt])
  @@map("listings")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  
  listingId   String
  listing     Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  reason      String
  description String?      @db.Text
  status      ReportStatus @default(pending)
  
  // Resolution
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([listingId])
  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

model Appeal {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  reason      String       @db.Text
  evidence    String[]     @default([])
  status      AppealStatus @default(pending)
  
  // Resolution
  reviewedAt  DateTime?
  reviewedBy  String?
  response    String?      @db.Text
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([userId])
  @@index([status])
  @@map("appeals")
}

model ModerationQueue {
  id          String           @id @default(uuid())
  listingId   String
  listing     Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  
  priority    Int              @default(0)
  assignedTo  String?
  moderator   User?            @relation("ModeratorActions", fields: [assignedTo], references: [id])
  
  status      ModerationStatus @default(pending)
  notes       String?          @db.Text
  
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@index([listingId])
  @@index([status])
  @@index([priority])
  @@map("moderation_queue")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model StaffNote {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  authorId    String
  content     String   @db.Text
  isInternal  Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([authorId])
  @@map("staff_notes")
}

model Payment {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount      Int
  currency    String        @default("RON")
  status      PaymentStatus @default(pending)
  method      PaymentMethod?
  
  // Stripe
  stripePaymentIntentId String? @unique
  stripeCustomerId      String?
  
  // Purpose
  purpose     String
  description String?
  metadata    Json?
  
  // Timestamps
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  paidAt      DateTime?
  
  // Relations
  invoices    Invoice[]
  
  @@index([userId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

model Invoice {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  paymentId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  
  invoiceNumber String      @unique
  amount      Int
  currency    String        @default("RON")
  status      InvoiceStatus @default(draft)
  
  items       Json
  metadata    Json?
  
  // Dates
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([userId])
  @@index([paymentId])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoices")
}

// Verification Requests
model VerificationRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // 'email', 'phone', 'business'
  status    String   @default("pending") // 'pending', 'approved', 'rejected'
  data      Json     // Request data (business info, documents, etc.)
  
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("verification_requests")
}

// Feature Flags
model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("feature_flags")
}

// Admin Broadcasts
model AdminBroadcast {
  id          String   @id @default(uuid())
  title       String
  message     String   @db.Text
  channels    Json
  segment     String   @default("all")
  status      String   @default("sent") // sent | scheduled
  scheduledAt DateTime?
  sentAt      DateTime?
  createdBy   String
  createdByUser User @relation("BroadcastCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  notifications UserNotification[]
  createdAt   DateTime @default(now())

  @@index([createdBy])
  @@index([status])
  @@map("admin_broadcasts")
}

// User Notifications
model UserNotification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcastId String?
  broadcast   AdminBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  title       String
  message     String   @db.Text
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([broadcastId])
  @@map("user_notifications")
}
