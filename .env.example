# Environment Configuration for Auto Platform
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/autoplatform?schema=public"

# JWT — obligatoriu în producție (openssl rand -base64 48). Fără el, login-ul nu funcționează.
JWT_SECRET="replace-with-long-random-secret-min-32-chars"

# Admin (opțional): folosit doar de prisma/seed în dev — NU seta parolă slabă în producție în seed dacă rulezi seed pe staging
# ADMIN_EMAIL="admin@clickanunt.ro"
# ADMIN_PASSWORD="change-me"

# Seed destructiv (șterge users + listings): în producție trebuie ALLOW_DANGEROUS_FULL_SEED=true sau se sare peste seed.
# ALLOW_DANGEROUS_FULL_SEED="false"

# S3-Compatible Cloud Storage (AWS S3, Cloudflare R2, DigitalOcean Spaces)
# For AWS S3:
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="us-east-1"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# For Cloudflare R2:
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="your-bucket-name"
# S3_ACCESS_KEY_ID="your-r2-access-key"
# S3_SECRET_ACCESS_KEY="your-r2-secret-key"

# For DigitalOcean Spaces:
# S3_ENDPOINT="https://nyc3.digitaloceanspaces.com"
# S3_REGION="nyc3"
# S3_BUCKET="your-space-name"
# S3_ACCESS_KEY_ID="your-spaces-key"
# S3_SECRET_ACCESS_KEY="your-spaces-secret"

# CDN Configuration (optional but recommended for millions of images)
# Cloudflare CDN or custom CDN domain
CDN_URL="https://cdn.yourdomain.com"

# Application Settings
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Când NEXT_PUBLIC_SHOW_COMPANY_LEGAL_DETAILS=true: telefon opțional în JSON-LD și pe /business (fără valoare = fără telefon în schema; pe Business butonul devine mailto suport).
# NEXT_PUBLIC_COMPANY_PHONE="+40 XX XXX XXXX"
# Optional: Google Search Console site verification (omit in dev if unused)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="paste-token-from-search-console"

# Image Upload Settings
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_LISTING=20

# Redis Cache (optional, for production scale)
# REDIS_URL="redis://localhost:6379"
# REDIS_PASSWORD=""

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET="your-session-secret-here"

# Cron jobs (/api/cron/*): Authorization: Bearer <CRON_SECRET>. Vercel: add CRON_SECRET in project env.
# CRON_SECRET="openssl-rand-base64-32-here"

# Email Service (optional, for notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ⚠️  IMPORTANT: Payment Gateway Configuration
# 
# SANDBOX/TESTING ONLY - Use test keys only!
# Never commit live payment keys to repository.
# Use different .env files for development vs production.
#
# For development/testing: Use sandbox keys below
# For production: Use LIVE keys (in secure vault, not in repo)

# Stripe Payment Gateway
# Test dashboard: https://dashboard.stripe.com/test/apikeys
# Live dashboard: https://dashboard.stripe.com/apikeys (doar în .env pe server, nu în repo)
#
# În producție: STRIPE_SECRET_KEY=sk_live_… și aceeași pereche pk_live ca mai jos (altfel apare mod test / „Enter 000000”).
# Preferă STRIPE_PUBLISHABLE_KEY pe VPS — citită la runtime; echivalent pentru browser fără doar NEXT_PUBLIC_* inliniat la build.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
# Opțional: destinatar pentru emailul de receipt Stripe (implicit: billing@clickanunt.ro din company-config).
# STRIPE_RECEIPT_EMAIL="billing@clickanunt.ro"
# STRIPE_ALLOW_TEST_KEYS_IN_PRODUCTION="1"

# PayPal / NetOpia (if used)
# Get sandbox credentials from: https://developer.paypal.com/
PAYPAL_CLIENT_ID="sb_123456789@business.example.com"  # Sandbox only
PAYPAL_CLIENT_SECRET="AaBbCcDdEeFfGgHhIiJjKkLl"  # Sandbox only
PAYPAL_MODE="sandbox"  # sandbox or live

# Payment Configuration
# Enable/disable payment methods for testing
ENABLE_STRIPE="true"
ENABLE_PAYPAL="true"
PAYMENT_MODE="sandbox"  # sandbox or production

# Webhook Configuration (for local testing)
STRIPE_WEBHOOK_URL="http://localhost:3000/api/payments/webhook"
PAYPAL_WEBHOOK_URL="http://localhost:3000/api/payments/netopia/ipn"

# ✅ TESTING CARD NUMBERS (Stripe Sandbox)
# - 4242 4242 4242 4242 - Visa (success)
# - 4000 0000 0000 0002 - Declined card
# - 3714 496353 98431 - Amex (success)
# Use any future date for expiry and any 3-digit CVC

# Analytics (optional)
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Monitoring (optional, for production)
# SENTRY_DSN="https://...@sentry.io/..."

# Playwright / local E2E: dezactivează rate limit la login/register (nu folosi în producție)
# E2E_DISABLE_RATE_LIMIT="1"

# ⚠️  SECURITY NOTES FOR PRODUCTION
# 1. Never use sk_test_* keys in production
# 2. Store live keys in environment variables on server
# 3. Use CI/CD secrets for sensitive values
# 4. Rotate webhook secrets regularly
# 5. Use HTTPS for all payment endpoints
# 6. Validate all payment signatures on server
# 7. Never log payment data
# 8. Use PCI-DSS compliant payment processor
